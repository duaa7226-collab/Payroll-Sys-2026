# Supabase PostgreSQL session/direct connection string for Prisma.
# Keep this value in the deployment secret store; never commit it.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# For serverless deployments, use Supavisor transaction mode for the app
# and keep a separate session/direct URL for Prisma migrations.
# DIRECT_URL="postgresql://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
