# ─────────────────────────────────────────────────────────────
# Environment template — copy to `.env` and fill in real values.
# `.env` is git-ignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL (Prisma, server-side only — never expose to the browser) ──
# Supabase → Project Settings → Database → Connection string (transaction pooler).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-pooler connection used by `prisma migrate dev` / `prisma migrate deploy`
# (see prisma.config.ts).
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (public, safe for the browser bundle) ──
# Project URL only — do NOT append `/rest/v1/`.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
# Legacy anon key, supported for existing deployments (used only when the
# publishable key above is absent):
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# ── Optional ──
# Directory for local reference copies of imported workbooks. The permanent
# archive lives in Supabase (UploadedFile table); defaults to ./upload.
# UPLOAD_DIR="./upload"

# Email sending (payslip delivery). Without a key the endpoint reports that
# email is not configured.
# RESEND_API_KEY="<resend-api-key>"
# RESEND_FROM_EMAIL="payroll@your-domain.com"
# RESEND_FROM_NAME="Nokhaba Payroll"
